{
  "name": "winston-desktop",
  "version": "1.3.0",
  "description": "Study Paws, your study buddy pet, as an always-on-top desktop widget.",
  "main": "main.js",
  "author": "Study Paws",
  "license": "MIT",
  "scripts": {
    "prestart": "node scripts/copy-app.js",
    "start": "electron .",
    "dist": "node scripts/copy-app.js && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.winston.studybuddy",
    "productName": "Study Paws",
    "files": [
      "main.js",
      "preload.js",
      "app/**",
      "build/tray.png"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "artifactName": "StudyPaws.${ext}",
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Study Paws listens to your class to write your notes."
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    },
    "nsis": {
      "artifactName": "StudyPaws-Setup.${ext}"
    },
    "portable": {
      "artifactName": "StudyPaws-Portable.${ext}"
    }
  }
}